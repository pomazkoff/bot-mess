{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron?channel=oloid",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron?channel=oloid",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/stats?notify=1",
      "schedule": "0 7 * * 1"
    }
  ],
  "functions": {
    "api/cron.ts": {
      "maxDuration": 300
    },
    "api/preview.ts": {
      "maxDuration": 300
    },
    "api/stats.ts": {
      "maxDuration": 120
    }
  }
}
